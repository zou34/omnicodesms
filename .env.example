# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Pooled connection used by the app at runtime (transaction-mode pooler)
DATABASE_URL="postgresql://user:password@localhost:5432/omnicodesms?schema=public"
# Direct connection used by Prisma Migrate (session-mode pooler / direct connection)
DIRECT_URL="postgresql://user:password@localhost:5432/omnicodesms?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Flutterwave
# ---------------------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TESTxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Virtual numbers / SMS provider (e.g. 5sim, SMS-Activate, Daisy SMS...)
# ---------------------------------------------------------------------------
# Which SmsProvider implementation lib/providers/index.ts should instantiate.
# "mock" simulates a provider in-memory (no API key needed) — use it for dev.
SMS_PROVIDER="mock"
SMS_PROVIDER_API_KEY="replace-with-provider-api-key"
SMS_PROVIDER_BASE_URL="https://api.sms-provider.example/v1"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
