# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Pooled connection used by the app at runtime (transaction-mode pooler)
DATABASE_URL="postgresql://user:password@localhost:5432/omnicodesms?schema=public"
# Direct connection used by Prisma Migrate (session-mode pooler / direct connection)
DIRECT_URL="postgresql://user:password@localhost:5432/omnicodesms?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# ---------------------------------------------------------------------------
# Payment gateway — lib/payments/index.ts. "mock" (default) drives
# /mock-checkout instead of a real hosted payment page; switch to a real
# provider once one has a class registered there.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
# Shared secret used to verify the HMAC signature on incoming webhook calls
# to /api/webhooks/payment (MockPaymentProvider signs its own test webhooks
# with it too). Required for that route to accept anything — never leave it
# unset in production, and never commit a real value here.
PAYMENT_WEBHOOK_SECRET="replace-with-a-strong-random-webhook-secret"

# ---------------------------------------------------------------------------
# Virtual numbers / SMS providers — lib/providers/index.ts. Auto-detects
# "smart" (5sim primary, GrizzlySMS fallback) once both keys below are set,
# "5sim" or "grizzly" if only one is, else "mock". Override explicitly with
# SMS_PROVIDER ("mock" | "5sim" | "grizzly" | "smart").
# ---------------------------------------------------------------------------
SIM5_API_KEY="replace-with-your-5sim-api-key"
GRIZZLY_API_KEY="replace-with-your-grizzlysms-api-key"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
